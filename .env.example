# O perfil abaixo já é o default versionado do Evidrun.
EVIDRUN_PROVIDER_BASE_URL=http://127.0.0.1:8318/v1
EVIDRUN_PROVIDER_MODEL=deepseek-v4-flash
EVIDRUN_PROVIDER_REASONING_EFFORT=max

# Use `evidrun provider set-key` para armazenar a chave no Keychain.
# Esta variável é apenas um override efêmero para CI ou ambientes sem Keychain.
EVIDRUN_PROVIDER_API_KEY=
