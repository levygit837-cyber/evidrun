{
  "$defs": {
    "ContractRef": {
      "additionalProperties": false,
      "properties": {
        "contract_type": {
          "$ref": "#/$defs/ContractType"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "logical_id": {
          "minLength": 1,
          "title": "Logical Id",
          "type": "string"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "contract_type",
        "logical_id",
        "revision",
        "digest"
      ],
      "title": "ContractRef",
      "type": "object"
    },
    "ContractType": {
      "enum": [
        "study",
        "goal",
        "scenario",
        "agent_inventory",
        "workspace_template",
        "interaction_protocol",
        "evaluation_plan",
        "checkpoint_policy",
        "progress_artifact_policy"
      ],
      "title": "ContractType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The exact, Project-bound v1 closure used to compile a Study.",
  "properties": {
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "revision_refs": {
      "items": {
        "$ref": "#/$defs/ContractRef"
      },
      "minItems": 1,
      "title": "Revision Refs",
      "type": "array"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "study_ref": {
      "$ref": "#/$defs/ContractRef"
    }
  },
  "required": [
    "project_id",
    "study_ref",
    "revision_refs"
  ],
  "title": "ExecutionRevisionSet",
  "type": "object"
}
