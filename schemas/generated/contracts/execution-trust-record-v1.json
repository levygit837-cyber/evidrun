{
  "$defs": {
    "ContractRef": {
      "additionalProperties": false,
      "properties": {
        "contract_type": {
          "$ref": "#/$defs/ContractType"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "logical_id": {
          "minLength": 1,
          "title": "Logical Id",
          "type": "string"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "contract_type",
        "logical_id",
        "revision",
        "digest"
      ],
      "title": "ContractRef",
      "type": "object"
    },
    "ContractType": {
      "enum": [
        "study",
        "goal",
        "scenario",
        "agent_inventory",
        "workspace_template",
        "interaction_protocol",
        "evaluation_plan",
        "checkpoint_policy",
        "progress_artifact_policy"
      ],
      "title": "ContractType",
      "type": "string"
    },
    "VerifiedDecisionBinding": {
      "additionalProperties": false,
      "properties": {
        "decision_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Decision Digest",
          "type": "string"
        },
        "revision_ref": {
          "$ref": "#/$defs/ContractRef"
        }
      },
      "required": [
        "revision_ref",
        "decision_digest"
      ],
      "title": "VerifiedDecisionBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable trust declared for one exact RunSpec.",
  "properties": {
    "created_at_utc": {
      "format": "date-time",
      "title": "Created At Utc",
      "type": "string"
    },
    "kind": {
      "enum": [
        "unverified_revision_set",
        "verified_revision_set"
      ],
      "title": "Kind",
      "type": "string"
    },
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "revision_refs": {
      "items": {
        "$ref": "#/$defs/ContractRef"
      },
      "minItems": 1,
      "title": "Revision Refs",
      "type": "array"
    },
    "revision_set_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Revision Set Digest",
      "type": "string"
    },
    "run_spec_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Run Spec Digest",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "study_ref": {
      "$ref": "#/$defs/ContractRef"
    },
    "trust_id": {
      "minLength": 1,
      "title": "Trust Id",
      "type": "string"
    },
    "verified_decisions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/VerifiedDecisionBinding"
      },
      "title": "Verified Decisions",
      "type": "array"
    }
  },
  "required": [
    "trust_id",
    "kind",
    "project_id",
    "study_ref",
    "revision_refs",
    "revision_set_digest",
    "run_spec_digest",
    "created_at_utc"
  ],
  "title": "ExecutionTrustRecord",
  "type": "object"
}
