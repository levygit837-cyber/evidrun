{
  "$defs": {
    "CapabilityDescriptorRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "name",
        "version",
        "digest"
      ],
      "title": "CapabilityDescriptorRef",
      "type": "object"
    },
    "CheckpointCaptureSpec": {
      "additionalProperties": false,
      "properties": {
        "agent_inventory": {
          "default": false,
          "title": "Agent Inventory",
          "type": "boolean"
        },
        "artifact_manifest": {
          "default": false,
          "title": "Artifact Manifest",
          "type": "boolean"
        },
        "context_snapshot": {
          "default": false,
          "title": "Context Snapshot",
          "type": "boolean"
        },
        "evaluation_records": {
          "default": false,
          "title": "Evaluation Records",
          "type": "boolean"
        },
        "protocol_state": {
          "default": false,
          "title": "Protocol State",
          "type": "boolean"
        },
        "provider_resolution": {
          "default": false,
          "title": "Provider Resolution",
          "type": "boolean"
        },
        "workspace_snapshot": {
          "default": false,
          "title": "Workspace Snapshot",
          "type": "boolean"
        }
      },
      "title": "CheckpointCaptureSpec",
      "type": "object"
    },
    "CheckpointDefinition": {
      "additionalProperties": false,
      "properties": {
        "capture": {
          "$ref": "#/$defs/CheckpointCaptureSpec"
        },
        "compatibility_tags": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Compatibility Tags",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "order": {
          "exclusiveMinimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "trigger": {
          "discriminator": {
            "mapping": {
              "event": "#/$defs/CheckpointEventTrigger",
              "manual": "#/$defs/ManualCheckpointTrigger",
              "predicate": "#/$defs/PredicateCheckpointTrigger",
              "protocol_node": "#/$defs/ProtocolNodeCheckpointTrigger"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ManualCheckpointTrigger"
            },
            {
              "$ref": "#/$defs/CheckpointEventTrigger"
            },
            {
              "$ref": "#/$defs/ProtocolNodeCheckpointTrigger"
            },
            {
              "$ref": "#/$defs/PredicateCheckpointTrigger"
            }
          ],
          "title": "Trigger"
        },
        "validator_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CapabilityDescriptorRef"
          },
          "title": "Validator Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "order",
        "trigger",
        "capture"
      ],
      "title": "CheckpointDefinition",
      "type": "object"
    },
    "CheckpointEventTrigger": {
      "additionalProperties": false,
      "properties": {
        "event_type": {
          "minLength": 1,
          "title": "Event Type",
          "type": "string"
        },
        "kind": {
          "const": "event",
          "default": "event",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "event_type"
      ],
      "title": "CheckpointEventTrigger",
      "type": "object"
    },
    "CheckpointPolicySpec": {
      "additionalProperties": false,
      "properties": {
        "definitions": {
          "items": {
            "$ref": "#/$defs/CheckpointDefinition"
          },
          "title": "Definitions",
          "type": "array"
        }
      },
      "required": [
        "definitions"
      ],
      "title": "CheckpointPolicySpec",
      "type": "object"
    },
    "ManualCheckpointTrigger": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "manual",
          "default": "manual",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "ManualCheckpointTrigger",
      "type": "object"
    },
    "PredicateCheckpointTrigger": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "predicate",
          "default": "predicate",
          "title": "Kind",
          "type": "string"
        },
        "predicate_ref": {
          "$ref": "#/$defs/CapabilityDescriptorRef"
        }
      },
      "required": [
        "predicate_ref"
      ],
      "title": "PredicateCheckpointTrigger",
      "type": "object"
    },
    "ProtocolNodeCheckpointTrigger": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "protocol_node",
          "default": "protocol_node",
          "title": "Kind",
          "type": "string"
        },
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "node_id"
      ],
      "title": "ProtocolNodeCheckpointTrigger",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_type": {
      "const": "checkpoint_policy",
      "default": "checkpoint_policy",
      "title": "Contract Type",
      "type": "string"
    },
    "logical_id": {
      "minLength": 1,
      "title": "Logical Id",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/CheckpointPolicySpec"
    },
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "revision": {
      "exclusiveMinimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "logical_id",
    "revision",
    "project_id",
    "title",
    "payload"
  ],
  "title": "CheckpointPolicyRevision",
  "type": "object"
}
