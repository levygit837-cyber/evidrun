{
  "$defs": {
    "AdjudicatesEvaluationRelation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "adjudicates",
          "default": "adjudicates",
          "title": "Kind",
          "type": "string"
        },
        "target_record_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Record Refs",
          "type": "array"
        }
      },
      "required": [
        "target_record_refs"
      ],
      "title": "AdjudicatesEvaluationRelation",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "classification": {
          "$ref": "#/$defs/Classification",
          "default": "internal"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "digest",
        "media_type"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CapabilityDescriptorRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "name",
        "version",
        "digest"
      ],
      "title": "CapabilityDescriptorRef",
      "type": "object"
    },
    "Classification": {
      "enum": [
        "public",
        "internal",
        "sensitive",
        "restricted"
      ],
      "title": "Classification",
      "type": "string"
    },
    "ContractRef": {
      "additionalProperties": false,
      "properties": {
        "contract_type": {
          "$ref": "#/$defs/ContractType"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "logical_id": {
          "minLength": 1,
          "title": "Logical Id",
          "type": "string"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "contract_type",
        "logical_id",
        "revision",
        "digest"
      ],
      "title": "ContractRef",
      "type": "object"
    },
    "ContractType": {
      "enum": [
        "study",
        "goal",
        "scenario",
        "agent_inventory",
        "workspace_template",
        "interaction_protocol",
        "evaluation_plan",
        "checkpoint_policy",
        "progress_artifact_policy"
      ],
      "title": "ContractType",
      "type": "string"
    },
    "DimensionValue": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "dimension_id": {
          "minLength": 1,
          "title": "Dimension Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "dimension_id",
        "value",
        "rationale",
        "evidence_refs"
      ],
      "title": "DimensionValue",
      "type": "object"
    },
    "EvaluationBoundary": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint Id"
        },
        "event_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Hash"
        },
        "up_to_event_sequence": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Up To Event Sequence"
        }
      },
      "title": "EvaluationBoundary",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "HumanAttestationRecord": {
      "additionalProperties": false,
      "description": "Evidence produced by a trusted human-verification adapter, not by API input.",
      "properties": {
        "action": {
          "enum": [
            "revision.accepted",
            "revision.rejected",
            "revision.superseded",
            "evaluation.adjudicated",
            "evaluation.reviewed"
          ],
          "title": "Action",
          "type": "string"
        },
        "assertion_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "attestation_id": {
          "minLength": 1,
          "title": "Attestation Id",
          "type": "string"
        },
        "challenge_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Challenge Digest",
          "type": "string"
        },
        "credential_id": {
          "minLength": 1,
          "title": "Credential Id",
          "type": "string"
        },
        "origin": {
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        },
        "principal_id": {
          "minLength": 1,
          "title": "Principal Id",
          "type": "string"
        },
        "relying_party_id": {
          "minLength": 1,
          "title": "Relying Party Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "subject_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Subject Digest",
          "type": "string"
        },
        "target_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Target Digest",
          "type": "string"
        },
        "user_verification": {
          "const": "required_verified",
          "default": "required_verified",
          "title": "User Verification",
          "type": "string"
        },
        "verification_method": {
          "const": "webauthn",
          "default": "webauthn",
          "title": "Verification Method",
          "type": "string"
        },
        "verified_at_utc": {
          "format": "date-time",
          "title": "Verified At Utc",
          "type": "string"
        },
        "verifier_ref": {
          "$ref": "#/$defs/CapabilityDescriptorRef"
        }
      },
      "required": [
        "attestation_id",
        "principal_id",
        "credential_id",
        "action",
        "target_digest",
        "subject_digest",
        "challenge_digest",
        "assertion_ref",
        "relying_party_id",
        "origin",
        "verifier_ref",
        "verified_at_utc"
      ],
      "title": "HumanAttestationRecord",
      "type": "object"
    },
    "IndependentHumanReviewRelation": {
      "additionalProperties": false,
      "properties": {
        "considers_record_refs": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Considers Record Refs",
          "type": "array"
        },
        "kind": {
          "const": "independent_review",
          "default": "independent_review",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "IndependentHumanReviewRelation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "boundary": {
      "$ref": "#/$defs/EvaluationBoundary"
    },
    "created_at_utc": {
      "format": "date-time",
      "title": "Created At Utc",
      "type": "string"
    },
    "dimension_values": {
      "items": {
        "$ref": "#/$defs/DimensionValue"
      },
      "title": "Dimension Values",
      "type": "array"
    },
    "evaluator_ref": {
      "$ref": "#/$defs/CapabilityDescriptorRef"
    },
    "gate_status": {
      "enum": [
        "passed",
        "failed",
        "not_applicable"
      ],
      "title": "Gate Status",
      "type": "string"
    },
    "human_attestation": {
      "anyOf": [
        {
          "$ref": "#/$defs/HumanAttestationRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "plan_ref": {
      "$ref": "#/$defs/ContractRef"
    },
    "provider_model": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Model"
    },
    "provider_profile_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Profile Id"
    },
    "record_id": {
      "minLength": 1,
      "title": "Record Id",
      "type": "string"
    },
    "relation": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "adjudicates": "#/$defs/AdjudicatesEvaluationRelation",
              "independent_review": "#/$defs/IndependentHumanReviewRelation"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AdjudicatesEvaluationRelation"
            },
            {
              "$ref": "#/$defs/IndependentHumanReviewRelation"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Relation"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_type": {
      "enum": [
        "deterministic_grader",
        "model_judge",
        "human_reviewer",
        "human_adjudicator"
      ],
      "title": "Source Type",
      "type": "string"
    },
    "stage_id": {
      "minLength": 1,
      "title": "Stage Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "provisional",
        "final"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "run_id",
    "plan_ref",
    "stage_id",
    "source_type",
    "evaluator_ref",
    "boundary",
    "dimension_values",
    "gate_status",
    "status",
    "created_at_utc"
  ],
  "title": "EvaluationRecord",
  "type": "object"
}
