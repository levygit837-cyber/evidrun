{
  "$defs": {
    "GoalConstraint": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "rule": {
          "enum": [
            "must",
            "must_not"
          ],
          "title": "Rule",
          "type": "string"
        }
      },
      "required": [
        "id",
        "rule",
        "description"
      ],
      "title": "GoalConstraint",
      "type": "object"
    },
    "GoalOutcome": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "title": "GoalOutcome",
      "type": "object"
    },
    "GoalSpec": {
      "additionalProperties": false,
      "properties": {
        "completion_observations": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Completion Observations",
          "type": "array"
        },
        "constraints": {
          "default": [],
          "items": {
            "$ref": "#/$defs/GoalConstraint"
          },
          "title": "Constraints",
          "type": "array"
        },
        "evidence_expectations": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Expectations",
          "type": "array"
        },
        "instruction": {
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "learning_targets": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Learning Targets",
          "type": "array"
        },
        "mode": {
          "enum": [
            "goal_state",
            "bounded_exploration"
          ],
          "title": "Mode",
          "type": "string"
        },
        "outcomes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/GoalOutcome"
          },
          "title": "Outcomes",
          "type": "array"
        }
      },
      "required": [
        "mode",
        "instruction"
      ],
      "title": "GoalSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_type": {
      "const": "goal",
      "default": "goal",
      "title": "Contract Type",
      "type": "string"
    },
    "logical_id": {
      "minLength": 1,
      "title": "Logical Id",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/GoalSpec"
    },
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "revision": {
      "exclusiveMinimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "logical_id",
    "revision",
    "project_id",
    "title",
    "payload"
  ],
  "title": "GoalRevision",
  "type": "object"
}
