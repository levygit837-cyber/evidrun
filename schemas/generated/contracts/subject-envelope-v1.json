    "SubjectWorkspace": {
      "additionalProperties": false,
      "properties": {
        "external_effect_mode": {
          "enum": [
            "denied",
            "approval_required",
            "allowlist"
          ],
          "title": "External Effect Mode",
          "type": "string"
        },
        "mounts": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Mounts",
          "type": "array"
        },
        "network_mode": {
          "enum": [
            "disabled",
            "provider_only",
            "allowlist"
          ],
          "title": "Network Mode",
          "type": "string"
        },
        "runtime_kind": {
          "minLength": 1,
          "title": "Runtime Kind",
          "type": "string"
        },
        "write_zones": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Write Zones",
          "type": "array"
        }
      },
      "required": [
        "runtime_kind",
        "network_mode",
        "external_effect_mode"
      ],
      "title": "SubjectWorkspace",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "budgets": {
      "$ref": "#/$defs/BudgetSpec"
    },
    "effective_capabilities": {
      "items": {
        "$ref": "#/$defs/ResolvedCapability"
      },
      "title": "Effective Capabilities",
      "type": "array"
    },
    "evaluation_guidance": {
      "anyOf": [
        {
          "$ref": "#/$defs/SubjectEvaluationGuidance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "goal": {
      "$ref": "#/$defs/GoalSpec"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/InputBinding"
      },
      "title": "Inputs",
      "type": "array"
    },
    "interaction_protocol": {
      "$ref": "#/$defs/InteractionProtocolSpec"
    },
    "run_spec_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Run Spec Digest",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "stop_conditions": {
      "items": {
        "$ref": "#/$defs/StopCondition"
      },
      "title": "Stop Conditions",
      "type": "array"
    },
    "workspace": {
      "$ref": "#/$defs/SubjectWorkspace"
