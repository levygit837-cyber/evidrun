            "$ref": "#/$defs/KeyValue"
          },
          "title": "Anchors",
          "type": "array"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "value_type": {
          "enum": [
            "boolean",
            "number",
            "category"
          ],
          "title": "Value Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description",
        "value_type"
      ],
