      "type": "object"
    },
    "SubjectEvaluationGuidance": {
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "items": {
            "$ref": "#/$defs/SubjectEvaluationDimension"
          },
          "title": "Dimensions",
          "type": "array"
        },
        "mode": {
          "const": "pre_run",
          "default": "pre_run",
          "title": "Mode",
          "type": "string"
        },
        "plan_ref": {
          "$ref": "#/$defs/ContractRef"
        }
      },
      "required": [
        "plan_ref",
        "dimensions"
      ],
      "title": "SubjectEvaluationGuidance",
      "type": "object"
