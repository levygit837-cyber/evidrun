{
  "$defs": {
    "CapabilityDescriptorRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "name",
        "version",
        "digest"
      ],
      "title": "CapabilityDescriptorRef",
      "type": "object"
    },
    "CheckpointReachedProgressTrigger": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_definition_id": {
          "minLength": 1,
          "title": "Checkpoint Definition Id",
          "type": "string"
        },
        "kind": {
          "const": "checkpoint_reached",
          "default": "checkpoint_reached",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "checkpoint_definition_id"
      ],
      "title": "CheckpointReachedProgressTrigger",
      "type": "object"
    },
    "ProgressArtifactDefinition": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "const": "laboratory_human",
          "default": "laboratory_human",
          "title": "Audience",
          "type": "string"
        },
        "authority_constraints": {
          "default": [
            "read_current_run_ledger_prefix",
            "write_progress_artifact_only",
            "no_subject_feedback"
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "const": "read_current_run_ledger_prefix",
              "type": "string"
            },
            {
              "const": "write_progress_artifact_only",
              "type": "string"
            },
            {
              "const": "no_subject_feedback",
              "type": "string"
            }
          ],
          "title": "Authority Constraints",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "input_scope": {
          "const": "complete_run_ledger_prefix",
          "default": "complete_run_ledger_prefix",
          "title": "Input Scope",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "max_output_characters": {
          "default": 12000,
          "exclusiveMinimum": 0,
          "title": "Max Output Characters",
          "type": "integer"
        },
        "minimum_interface_version": {
          "default": "1",
          "minLength": 1,
          "title": "Minimum Interface Version",
          "type": "string"
        },
        "summarizer_ref": {
          "$ref": "#/$defs/CapabilityDescriptorRef"
        },
        "trigger": {
          "discriminator": {
            "mapping": {
              "checkpoint_reached": "#/$defs/CheckpointReachedProgressTrigger",
              "subject_turn_interval": "#/$defs/SubjectTurnIntervalProgressTrigger"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CheckpointReachedProgressTrigger"
            },
            {
              "$ref": "#/$defs/SubjectTurnIntervalProgressTrigger"
            }
          ],
          "title": "Trigger"
        }
      },
      "required": [
        "id",
        "label",
        "trigger",
        "summarizer_ref"
      ],
      "title": "ProgressArtifactDefinition",
      "type": "object"
    },
    "ProgressArtifactPolicySpec": {
      "additionalProperties": false,
      "properties": {
        "definitions": {
          "items": {
            "$ref": "#/$defs/ProgressArtifactDefinition"
          },
          "title": "Definitions",
          "type": "array"
        },
        "limitations": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "definitions"
      ],
      "title": "ProgressArtifactPolicySpec",
      "type": "object"
    },
    "SubjectTurnIntervalProgressTrigger": {
      "additionalProperties": false,
      "properties": {
        "counted_event_type": {
          "const": "subject.responded",
          "default": "subject.responded",
          "title": "Counted Event Type",
          "type": "string"
        },
        "every_n_turns": {
          "exclusiveMinimum": 0,
          "title": "Every N Turns",
          "type": "integer"
        },
        "kind": {
          "const": "subject_turn_interval",
          "default": "subject_turn_interval",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "every_n_turns"
      ],
      "title": "SubjectTurnIntervalProgressTrigger",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_type": {
      "const": "progress_artifact_policy",
      "default": "progress_artifact_policy",
      "title": "Contract Type",
      "type": "string"
    },
    "logical_id": {
      "minLength": 1,
      "title": "Logical Id",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/ProgressArtifactPolicySpec"
    },
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "revision": {
      "exclusiveMinimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "logical_id",
    "revision",
    "project_id",
    "title",
    "payload"
  ],
  "title": "ProgressArtifactPolicyRevision",
  "type": "object"
}
