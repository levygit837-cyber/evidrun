{
  "additionalProperties": false,
  "description": "Durable operational queue state for one canonical Run.",
  "properties": {
    "active_attempt_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Attempt Id"
    },
    "available_at_utc": {
      "format": "date-time",
      "title": "Available At Utc",
      "type": "string"
    },
    "created_at_utc": {
      "format": "date-time",
      "title": "Created At Utc",
      "type": "string"
    },
    "finished_at_utc": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At Utc"
    },
    "idempotency_key": {
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "job_id": {
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "lease_generation": {
      "minimum": 0,
      "title": "Lease Generation",
      "type": "integer"
    },
    "rejection_code": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rejection Code"
    },
    "request_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "leased",
        "completed",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "run_id",
    "status",
    "idempotency_key",
    "request_digest",
    "available_at_utc",
    "lease_generation",
    "created_at_utc"
  ],
  "title": "RunExecutionJob",
  "type": "object"
}
