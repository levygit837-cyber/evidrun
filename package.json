{
  "name": "evidrun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "apps/desktop/dist/main/index.js",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "build:desktop": "tsc -p apps/desktop/tsconfig.main.json && tsc -p apps/desktop/tsconfig.preload.json",
    "typecheck:desktop": "tsc --noEmit -p apps/desktop/tsconfig.main.json && tsc --noEmit -p apps/desktop/tsconfig.preload.json",
    "desktop:dev": "pnpm build:desktop && concurrently -k \"pnpm dev:web\" \"wait-on http://127.0.0.1:5173 && cross-env EVIDRUN_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "desktop:start": "electron .",
    "build": "pnpm build:web && pnpm build:desktop",
    "test:web": "vitest run --config apps/web/vitest.config.ts",
    "test:desktop": "vitest run --config apps/desktop/vitest.config.ts",
    "test:handshake": "node scripts/smoke_desktop_handshake.mjs",
    "test": "pnpm test:web && pnpm test:desktop",
    "package:desktop": "pnpm build && electron-forge package",
    "make:desktop": "pnpm build && electron-forge make"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "5.101.3",
    "@tanstack/react-router": "^1.131.35",
    "lucide-react": "^0.468.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-dmg": "^7.8.3",
    "@electron-forge/maker-zip": "^7.8.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "43.2.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.59.0",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.0",
    "vite": "8.1.5",
    "vitest": "^4.0.0",
    "wait-on": "^8.0.1"
  },
  "config": {
    "forge": "./apps/desktop/forge.config.cjs"
  }
}
